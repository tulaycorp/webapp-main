{
  "name": "webapp",
  "version": "2.0.0",
  "description": "Modern e-commerce web application with Tailwind CSS design system",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "tailwindcss -i ./styles.css -o ./dist/styles.css --minify",
    "watch:css": "tailwindcss -i ./styles.css -o ./dist/styles.css --watch",
    "build:js": "node scripts/build-js.js",
    "build": "npm run build:css && npm run build:js",
    "setup": "npm install && npm run build",
    "dev": "npm run watch:css",
    "start": "echo \"Open pages/index.php in your browser to view the application\""
  },
  "keywords": ["webapp", "ecommerce", "tailwind", "modern-ui", "responsive"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "lucide": "^0.460.0",
    "jquery-validation": "^1.21.0",
    "express": "^4.18.2",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "nodemon": "^3.0.1"
  }
}
