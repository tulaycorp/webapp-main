{
  "name": "webapp",
  "version": "1.0.0",
  "description": "Modern e-commerce web application with enhanced UI/UX design principles",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:css": "postcss styles.css -o dist/styles.css",
    "build:js": "node scripts/build-js.js",
    "watch:css": "postcss styles.css -o dist/styles.css --watch",
    "build": "npm run build:css && npm run build:js",
    "setup": "npm install && npm run build",
    "start": "echo \"Open pages/index.php in your browser to view the application\""
  },
  "keywords": ["webapp", "ecommerce", "bootstrap", "modern-ui", "responsive"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
  "bootstrap": "^5.3.8",
  "bulma": "^1.0.4",
  "jquery-validation": "^1.21.0",
  "express": "^4.18.2",
  "cors": "^2.8.5",
  "bootstrap-icons": "^1.11.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "nodemon": "^3.0.1"
  }
}
