{
  "name": "webapp",
  "version": "1.0.0",
  "description": "Modern e-commerce web application with Express.js server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "postcss src/css/styles.css -o public/css/styles.css",
    "watch:css": "postcss src/css/styles.css -o public/css/styles.css --watch",
    "build": "npm run build:css",
    "setup": "npm install && npm run build"
  },
  "keywords": ["ecommerce", "express", "bootstrap", "webapp"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "bootstrap": "^5.3.8",
    "jquery-validation": "^1.21.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1"
  }
}
